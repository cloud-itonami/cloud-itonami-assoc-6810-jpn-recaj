(ns association.facts-test
  "The catalog as a body of citations, not as a count.

  Thirteen entries were added on 2026-09-09, which is the size at which a
  catalog starts to acquire a fabricated URL, a copied-down date, or a second
  entry for a document already in the table. The assertions below are the ones
  that would have caught each of those, so they are written over the whole
  catalog rather than over the entry someone happened to look at.

  What they cannot check is whether the URL still resolves -- the suite is
  hermetic on purpose. `nbb scripts/verify_citations.cljk` is the check that
  goes and looks."
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            [clojure.test :refer [deftest is testing]]
            [association.facts :as facts]))

(def ^:private slug "recaj")
(def ^:private entries (vec (facts/spec-basis slug)))

(def ^:private tx-data
  "The file the Kotoba port is generated from. Reading it here is what makes
   the two files one catalog instead of two."
  (edn/read-string (slurp "data/datascript-tx.edn")))

(deftest recaj-has-spec-basis
  (is (seq entries))
  (is (every? #(re-find #"^https?://(www\.)?fdk\.or\.jp/" (:association-rule/url %)) entries)
      "an entry whose URL is not on the association's own host is not a citation")
  (is (every? #(= "6810" (:association-rule/isic %)) entries))
  (is (every? #(= "JPN" (:association-rule/country %)) entries))
  (is (every? #(= slug (:association-rule/association %)) entries)))

(deftest every-citation-is-distinct
  ;; A catalog grows by appending, and appending is how the same document gets
  ;; cited twice under two ids.
  (let [ids (map :association-rule/id entries)
        urls (map :association-rule/url entries)]
    (is (= (count entries) (count (distinct ids))) (pr-str (frequencies ids)))
    (is (= (count entries) (count (distinct urls))) (pr-str (frequencies urls)))
    (is (every? #(str/starts-with? % (str slug ".")) ids))))

(deftest kinds-and-provenance-come-from-a-closed-vocabulary
  ;; A typo'd keyword is not an error anywhere else -- it just silently answers
  ;; no query.
  (is (every? #{:self-regulatory-code :governance-program :practice-guidance}
              (map :association-rule/kind entries)))
  (is (every? #{:official-association-site}
              (map :association-rule/url-provenance entries))))

(deftest every-entry-carries-at-least-one-topic
  ;; A topicless entry is reachable by id and by nothing else, which is the
  ;; quiet way an entry stops being part of the catalog.
  (doseq [e entries]
    (testing (:association-rule/id e)
      (is (seq (:association-rule/topic e)))
      (is (every? keyword? (:association-rule/topic e))))))

(deftest dates-are-iso-and-ordered-when-present
  ;; RECAJ prints a full date for its agreements and board approvals, and only
  ;; a year (昭和52年) or a year and month (令和6年3月) for some others. An
  ;; absent date is the honest answer for those; a completed one would be
  ;; indistinguishable from a fact.
  (doseq [e entries]
    (testing (:association-rule/id e)
      (let [est (:association-rule/established-date e)
            rev (:association-rule/last-revised-date e)]
        (when est (is (re-matches #"\d{4}-\d{2}-\d{2}" est)))
        (when rev (is (re-matches #"\d{4}-\d{2}-\d{2}" rev)))
        (when (and est rev)
          (is (not (neg? (compare rev est)))
              "a document cannot have been amended before it was enacted"))
        (is (re-matches #"\d{4}-\d{2}-\d{2}" (:association-rule/retrieved-at e))))))
  ;; The floor: if every date went missing, the loop above would assert nothing
  ;; and still pass.
  (is (<= 7 (count (filter :association-rule/established-date entries)))
      "the dated entries are the ones whose page prints a full date")
  (is (<= 2 (count (filter :association-rule/last-revised-date entries)))))

(deftest the-cljc-and-the-data-file-are-one-catalog
  ;; src/association_facts.kotoba is generated from data/datascript-tx.edn while
  ;; this map is written out separately, so without this the two could disagree
  ;; and the .kotoba parity test would report the mismatch against the wrong
  ;; file.
  (is (= (count tx-data) (count entries)))
  (doseq [[i [from-data from-cljc]] (map-indexed vector (map vector tx-data entries))]
    (testing (str "entry " i)
      (is (= (dissoc from-data :association-rule/topic)
             (dissoc from-cljc :association-rule/topic)))
      (is (= (set (:association-rule/topic from-data))
             (:association-rule/topic from-cljc))
          "the data file writes topics as a vector, the map holds a set"))))

(deftest unknown-association-has-no-spec-basis
  (is (nil? (facts/spec-basis "keidanren")))
  (is (nil? (facts/spec-basis "zzz"))))

(deftest coverage-is-honest
  (let [c (facts/coverage [slug "keidanren"])]
    (is (= 2 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["keidanren"] (:missing-associations c)))
    (is (str/includes? (:note c) (str (count entries) " recaj entries")))))

(deftest by-topic-filters
  ;; Named entries, not counts: a count passes when by-topic returns the wrong
  ;; entries in the right number.
  (is (= ["recaj.after-service-standard-mid-high-rise"
          "recaj.after-service-standard-detached-house"
          "recaj.after-service-standard-residential-land"]
         (mapv :association-rule/id (facts/by-topic slug :after-service))))
  (is (= ["recaj.voluntary-action-plan-fair-transactions"
          "recaj.speculative-short-term-resale-measures"]
         (mapv :association-rule/id (facts/by-topic slug :fair-transaction))))
  (is (= ["recaj.condominium-trust-restoration-agreement"
          "recaj.foundation-pile-construction-measures"]
         (mapv :association-rule/id (facts/by-topic slug :building-safety))))
  (is (= ["recaj.long-term-repair-plan-preparation-guideline"
          "recaj.repair-reserve-fund-policy"]
         (mapv :association-rule/id (facts/by-topic slug :building-maintenance))))
  (is (= ["recaj.barrier-free-information-agreement"]
         (mapv :association-rule/id (facts/by-topic slug :accessibility))))
  (is (= ["recaj.business-continuity-plan-guideline-office"]
         (mapv :association-rule/id (facts/by-topic slug :business-continuity))))
  (is (= ["recaj.real-estate-industry-environment-action-plan"]
         (mapv :association-rule/id (facts/by-topic slug :environment))))
  (is (= ["recaj.personal-information-handling-policy"]
         (mapv :association-rule/id (facts/by-topic slug :privacy))))
  (is (= 10 (count (facts/by-topic slug :consumer-protection))))
  (is (= 2 (count (facts/by-topic slug :governance))))
  (is (empty? (facts/by-topic slug :labor)))
  (is (empty? (facts/by-topic "keidanren" :governance))))
