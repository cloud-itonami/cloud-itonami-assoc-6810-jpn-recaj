;; The RECAJ source catalog, as Kotoba.
;;
;; GENERATED from data/datascript-tx.edn by
;; scripts/gen_association_facts_kotoba.cljs -- do not edit by hand; edit the
;; data file and regenerate. `src/association/facts.cljc` holds the same
;; catalog, and association.facts-test asserts the two agree, so the data
;; file is the one source all three readings come from. This one reaches the
;; Kotoba oracle, wasm and both native ISAs, which the .cljc cannot.
;;
;; `:topic` is a SET in the .cljc. A set has no order and `topic` is indexed
;; by position, so the generator uses the order the data file writes.
;; `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every field
;; of every entry against the .cljc, so this file cannot drift from the data
;; without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "recaj"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 15 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 15)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "recaj.articles-of-incorporation")
        (string=? f "title") (option-some-of [:option :string] "定款 (Articles of Incorporation)")
        (string=? f "association") (option-some-of [:option :string] "recaj")
        (string=? f "isic") (option-some-of [:option :string] "6810")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "http://www.fdk.or.jp/f_outline/pdf/teikan.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
