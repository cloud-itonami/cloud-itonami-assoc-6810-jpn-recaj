(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0)
      1
      (= i 1)
      2
      (= i 2)
      2
      (= i 3)
      2
      (= i 4)
      2
      (= i 5)
      2
      (= i 6)
      2
      (= i 7)
      2
      (= i 8)
      2
      (= i 9)
      2
      (= i 10)
      2
      (= i 11)
      2
      (= i 12)
      1
      (= i 13)
      1
      (= i 14)
      2
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
  (cond
    (= i 0)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 1)
    (cond
      (= t 0) (option-some-of [:option :string] "fair-transaction")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 2)
    (cond
      (= t 0) (option-some-of [:option :string] "after-service")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 3)
    (cond
      (= t 0) (option-some-of [:option :string] "after-service")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 4)
    (cond
      (= t 0) (option-some-of [:option :string] "after-service")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 5)
    (cond
      (= t 0) (option-some-of [:option :string] "building-safety")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 6)
    (cond
      (= t 0) (option-some-of [:option :string] "building-safety")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 7)
    (cond
      (= t 0) (option-some-of [:option :string] "accessibility")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 8)
    (cond
      (= t 0) (option-some-of [:option :string] "fair-transaction")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 9)
    (cond
      (= t 0) (option-some-of [:option :string] "business-continuity")
      (= t 1) (option-some-of [:option :string] "disaster-preparedness")
      :else (option-none-of [:option :string]))
    (= i 10)
    (cond
      (= t 0) (option-some-of [:option :string] "building-maintenance")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 11)
    (cond
      (= t 0) (option-some-of [:option :string] "building-maintenance")
      (= t 1) (option-some-of [:option :string] "consumer-protection")
      :else (option-none-of [:option :string]))
    (= i 12)
    (cond
      (= t 0) (option-some-of [:option :string] "digital-standard")
      :else (option-none-of [:option :string]))
    (= i 13)
    (cond
      (= t 0) (option-some-of [:option :string] "environment")
      :else (option-none-of [:option :string]))
    (= i 14)
    (cond
      (= t 0) (option-some-of [:option :string] "privacy")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "governance") 2
      (string=? candidate "fair-transaction") 2
      (string=? candidate "consumer-protection") 10
      (string=? candidate "after-service") 3
      (string=? candidate "building-safety") 2
      (string=? candidate "accessibility") 1
      (string=? candidate "business-continuity") 1
      (string=? candidate "disaster-preparedness") 1
      (string=? candidate "building-maintenance") 2
      (string=? candidate "digital-standard") 1
      (string=? candidate "environment") 1
      (string=? candidate "privacy") 1
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (cond
        (string=? candidate "governance") (option-some-of [:option :string] "recaj.articles-of-incorporation")
        (string=? candidate "fair-transaction") (option-some-of [:option :string] "recaj.voluntary-action-plan-fair-transactions")
        (string=? candidate "consumer-protection") (option-some-of [:option :string] "recaj.voluntary-action-plan-fair-transactions")
        (string=? candidate "after-service") (option-some-of [:option :string] "recaj.after-service-standard-mid-high-rise")
        (string=? candidate "building-safety") (option-some-of [:option :string] "recaj.condominium-trust-restoration-agreement")
        (string=? candidate "accessibility") (option-some-of [:option :string] "recaj.barrier-free-information-agreement")
        (string=? candidate "business-continuity") (option-some-of [:option :string] "recaj.business-continuity-plan-guideline-office")
        (string=? candidate "disaster-preparedness") (option-some-of [:option :string] "recaj.business-continuity-plan-guideline-office")
        (string=? candidate "building-maintenance") (option-some-of [:option :string] "recaj.long-term-repair-plan-preparation-guideline")
        (string=? candidate "digital-standard") (option-some-of [:option :string] "recaj.bim-apartment-brochure-drawing-handbook")
        (string=? candidate "environment") (option-some-of [:option :string] "recaj.real-estate-industry-environment-action-plan")
        (string=? candidate "privacy") (option-some-of [:option :string] "recaj.personal-information-handling-policy")
        :else (option-none-of [:option :string]))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-6810-jpn-recaj (ADR-2607141700): 15 recaj entries, each with an official citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
